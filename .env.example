POSTGRES_DB=vaurenith
POSTGRES_USER=vaurenith_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1

DATABASE_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_PUBLIC_KEY_PATH=.local/keys/jwt-public.pem
AUTH_JWT_CLOCK_SKEW_SECONDS=30
AUTH_JWT_MAX_LIFETIME_SECONDS=3600

TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/vaurenith_test

CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

API_PREFIX=/api/v1
LOG_LEVEL=INFO
MAX_REQUEST_BODY_SIZE=10485760
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
